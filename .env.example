# Transparent Classroom credentials (required)
# These are used for TC API (Basic auth) and as the default for Onespot/Firebase login.
TC_EMAIL=you@example.com
TC_PASSWORD=your-tc-password

# Onespot / Firebase credentials (optional)
# If your Onespot account uses the same email/password as TC, leave these unset.
# If you have a separate direct Onespot login, set them here.
ONESPOT_EMAIL=
ONESPOT_PASSWORD=

# Onespot school app ID (optional — auto-detected from your profile if omitted)
# Find it by calling the onespot_get_my_profile tool and looking at mostRecentApp.
ONESPOT_APP_ID=
